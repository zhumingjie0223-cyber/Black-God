web/nexus-do/nexus_do.mjs
web/nexus-do/node_modules/
web/nexus-do/container/node_modules/
web/nexus-do/package-lock.json
.wrangler
web/_old_backup/

# ── 备份与临时文件 ─────────────────────────
*.bak
*.bak.*
*.orig
*.old
*.tmp
*.log
*.moved-aside
.DS_Store

# ── Python ───────────────────────────────
__pycache__/
*.py[cod]
.Python

# ── Xcode ────────────────────────────────
*.hmap
*.ipa
*.xccheckout
*.xcuserstate
*.xcworkspace
