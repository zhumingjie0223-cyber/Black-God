# ── 环境变量与密钥（绝不上传）────────────────
.env
.env.*
!.env.example
.dev.vars*
*.key
*.pem
*.p8
*password*
*secret*

# ── 私人数据 ──────────────────────────────
*.db
.learnings/

# ── 构建产物 ──────────────────────────────
build/
DerivedData
.buildstamp

# ── 备份与临时文件 ─────────────────────────
*.bak
*.bak.*
*.orig
*.old
*.tmp
*.log
*.moved-aside
.DS_Store
node_modules/

# ── Python ───────────────────────────────
__pycache__/
*.py[cod]
.Python

# ── Xcode ────────────────────────────────
*.hmap
*.ipa
*.xccheckout
*.xcuserstate
*.xcworkspace
*.mode1v3
*.mode2v3
*.pbxuser
*.perspectivev3
xcuserdata/
!default.mode1v3
!default.mode2v3
!default.pbxuser
!default.perspectivev3
!default.xcworkspace

# iOS：xcodegen 生成物不入库，真源是 ios-app/project.yml
ios-app/*.xcodeproj/
ios-app/Info.plist
ios-app/build/
ios-app/DerivedData/

# ── App Store 截图脚本产出（由 screenshots.html 随时可重新生成）──
ios-app/AppStore/png/
ios-app/AppStore/node_modules/
ios-app/AppStore/package*.json
