.env.cloudflare
*.env.cloudflare
.dev.vars*
!.dev.vars.example
*.key
*.pem
*password*
*secret*
server/webpush/vapid_private.pem
server/webpush/vapid_keys.txt

# ── 私人数据 ──────────────────────────────
server/data/
server/memory/*.json
server/uploads/
server/voice_cache/
server/generated_images/
*.db
claude_pool/
.learnings/

