# App Store release workflow. Run from ios-app; see AppStore/SUBMIT_GUIDE.md.
require "json"
require "shellwords"
require "yaml"

NEXUS_IOS_ROOT = File.expand_path("..", __dir__)
NEXUS_METADATA = File.join(NEXUS_IOS_ROOT, "AppStore", "metadata")

def nexus_required_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing #{name}; see AppStore/SUBMIT_GUIDE.md") if value.empty?
  value
end

def nexus_project_version
  YAML.load_file(File.join(NEXUS_IOS_ROOT, "project.yml")).fetch("settings").fetch("base")
end

def nexus_screenshots
  directory = File.expand_path(nexus_required_env("ASC_SCREENSHOTS_DIR"))
  ["zh-Hans", "en-US"].each do |locale|
    images = Dir.glob(File.join(directory, locale, "*.png")).sort
    UI.user_error!("Supply 1–10 verified PNG app screenshots for #{locale}") unless (1..10).cover?(images.length)
    images.each do |file|
      bytes = File.binread(file)
      header = bytes.byteslice(0, 26).to_s
      valid = header.bytesize == 26 && header.start_with?("\x89PNG\r\n\x1a\n".b)
      dimensions = valid ? header.byteslice(16, 8).unpack("NN") : []
      # Current iPhone 6.9-inch portrait sizes. Other formats can be uploaded in the web UI.
      valid &&= [[1260, 2736], [1290, 2796], [1320, 2868]].include?(dimensions)
      # RGB PNG only; excludes alpha, palettes and grayscale from this upload lane.
      valid &&= header.getbyte(25) == 2
      # RGB PNG can still contain a tRNS transparency chunk.
      offset = 8
      complete = false
      while valid && offset + 12 <= bytes.bytesize
        length = bytes.byteslice(offset, 4).unpack1("N")
        type = bytes.byteslice(offset + 4, 4)
        valid &&= offset + length + 12 <= bytes.bytesize && type != "tRNS"
        offset += length + 12
        if type == "IEND"
          complete = true
          break
        end
      end
      valid &&= complete
      UI.user_error!("Screenshot must be an opaque RGB PNG in an accepted portrait size: #{File.basename(file)}") unless valid
    end
  end
  directory
end

def nexus_submission_config
  file = File.expand_path(nexus_required_env("ASC_SUBMISSION_CONFIG"))
  UI.user_error!("ASC_SUBMISSION_CONFIG must identify a private JSON file") unless File.file?(file)
  raw = File.read(file)
  UI.user_error!("Replace pending submission values before running this lane") if raw.match?(/\b(?:PENDING|TODO|TBD|XXXXXXXX)\b|待填写|待确认|<[^>]+>/i)
  data = JSON.parse(raw)
  %w[app_version build_number copyright].each do |key|
    UI.user_error!("Missing submission value: #{key}") unless data[key].is_a?(String) && !data[key].strip.empty?
  end
  version = nexus_project_version
  UI.user_error!("Submission version/build differs from project.yml") unless data["app_version"] == version["MARKETING_VERSION"].to_s && data["build_number"] == version["CURRENT_PROJECT_VERSION"].to_s
  UI.user_error!("automatic_release must be true or false") unless [true, false].include?(data["automatic_release"])
  review = data["app_review_information"]
  UI.user_error!("Missing app_review_information object") unless review.is_a?(Hash)
  %w[first_name last_name phone_number email_address notes].each do |key|
    UI.user_error!("Missing review value: #{key}") unless review[key].is_a?(String) && !review[key].strip.empty?
  end
  info = data["submission_information"]
  UI.user_error!("Missing submission_information object") unless info.is_a?(Hash)
  %w[export_compliance_uses_encryption content_rights_contains_third_party_content add_id_info_uses_idfa].each do |key|
    UI.user_error!("#{key} must be an answered boolean") unless [true, false].include?(info[key])
  end
  data
rescue JSON::ParserError
  UI.user_error!("ASC_SUBMISSION_CONFIG is not valid JSON")
end

default_platform(:ios)

platform :ios do
  private_lane :asc_auth do
    names = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8]
    if names.any? { |name| !ENV[name].to_s.empty? }
      values = names.to_h { |name| [name, nexus_required_env(name)] }
      UI.user_error!("ASC_KEY_P8 does not exist") unless File.file?(values["ASC_KEY_P8"])
      app_store_connect_api_key(key_id: values["ASC_KEY_ID"], issuer_id: values["ASC_ISSUER_ID"], key_filepath: values["ASC_KEY_P8"], in_house: false)
    else
      nexus_required_env("APPLE_ID")
      nil # fastlane uses the account from Appfile, including its normal authentication flow.
    end
  end

  desc "Validate local files, archive and export a signed IPA; no upload"
  lane :build do
    sh("cd #{NEXUS_IOS_ROOT.shellescape} && node AppStore/preflight.mjs && xcodegen generate")
    build_app(
      project: File.join(NEXUS_IOS_ROOT, "BlackGod888.xcodeproj"),
      scheme: "BlackGod888", configuration: "Release", export_method: "app-store",
      output_directory: File.join(NEXUS_IOS_ROOT, "build"), output_name: "BlackGod888.ipa"
    )
  end

  desc "Upload an existing IPA, metadata and supplied real app screenshots; no review submission"
  lane :upload do
    screenshots = nexus_screenshots
    ipa = File.expand_path(nexus_required_env("IPA_PATH"))
    UI.user_error!("IPA_PATH does not exist") unless File.file?(ipa)
    sh("cd #{NEXUS_IOS_ROOT.shellescape} && node AppStore/preflight.mjs")
    api_key = asc_auth
    upload_to_app_store(
      api_key: api_key, ipa: ipa,
      app_version: nexus_project_version["MARKETING_VERSION"].to_s,
      metadata_path: NEXUS_METADATA, screenshots_path: screenshots,
      submit_for_review: false, force: true, overwrite_screenshots: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Submit the exact uploaded version/build using private, completed review information"
  lane :submit do
    data = nexus_submission_config
    api_key = asc_auth
    upload_to_app_store(
      api_key: api_key, app_version: data.fetch("app_version"), build_number: data.fetch("build_number"),
      metadata_path: NEXUS_METADATA, copyright: data.fetch("copyright"),
      app_review_information: data.fetch("app_review_information").transform_keys(&:to_sym),
      submission_information: data.fetch("submission_information").transform_keys(&:to_sym),
      automatic_release: data.fetch("automatic_release"), submit_for_review: true,
      skip_binary_upload: true, skip_screenshots: true, force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build and upload for inspection in App Store Connect; submit is a separate lane"
  lane :release do
    nexus_screenshots # Check required input before spending time on a signed build.
    build
    ENV["IPA_PATH"] = File.join(NEXUS_IOS_ROOT, "build", "BlackGod888.ipa")
    upload
    UI.success("Uploaded. Complete the App Store Connect declarations, then run fastlane submit or submit in the web UI.")
  end
end
