app_identifier("com.blackgod.nexus")
# API authentication: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (private .p8 path).
# Apple ID fallback: set APPLE_ID; fastlane handles login and two-factor authentication.
# Never commit passwords, API keys, review credentials or submission JSON.
apple_id(ENV["APPLE_ID"]) unless ENV["APPLE_ID"].to_s.empty?
itc_team_id(ENV["ASC_TEAM_ID"]) unless ENV["ASC_TEAM_ID"].to_s.empty?
team_id(ENV["APPLE_TEAM_ID"] || "8429ZL8NQ9")
