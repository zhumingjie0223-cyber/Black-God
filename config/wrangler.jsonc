{
  "name": "blackgod88",
  "main": "../worker.mjs",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "b8fe73eb47754b2abd872edce797474a"
    }
  ],
  "vars": {
    "PUBLIC_MODE": "1"
  },
  "observability": {
    "enabled": true
  }
}
